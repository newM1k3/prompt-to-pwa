{
  "name": "prompt-to-pwa",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "validate-env": "node scripts/validate-env.mjs",
    "smoke-test": "node scripts/smoke-test.mjs",
    "typecheck": "tsc -b --pretty false",
    "check": "npm run lint && npm run typecheck && npm run build"
  },
  "dependencies": {
    "@stripe/stripe-js": "^9.13.0",
    "@tailwindcss/vite": "^4.3.3",
    "acorn": "^8.18.0",
    "archiver": "^8.0.0",
    "lucide-react": "^1.31.0",
    "pocketbase": "^0.27.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "stripe": "^22.5.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  },
  "description": "An MVP that turns product prompts into generated progressive web app blueprints, previews, and downloadable source.",
  "engines": {
    "node": ">=20 <25",
    "npm": ">=10"
  }
}
