# ============================================================================
# Prompt-to-PWA — Environment Variables
# Copy to .env for local dev. Set in Netlify Dashboard for production.
# NEVER commit real values to git.
# ============================================================================

# ── PocketBase ────────────────────────────────────────────────────────────
# URL of your PocketBase instance (required)
# Local dev: http://127.0.0.1:8090
# Production: https://your-project.pockethost.io or https://pb.yourdomain.com
VITE_POCKETBASE_URL=

# PocketBase admin credentials (for server-side writes from Netlify Functions)
# Never exposed to the client. Used only in Netlify Functions via process.env.
POCKETBASE_ADMIN_EMAIL=
POCKETBASE_ADMIN_PASSWORD=

# ── AI APIs ───────────────────────────────────────────────────────────────
# Gemini Flash API key (for blueprint generation)
# Get from: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Anthropic / Claude API key (for app compilation)
# Get from: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# ── Stripe ────────────────────────────────────────────────────────────────
# Secret key — NEVER exposed to client
# Get from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=

# Webhook signing secret — validates events really came from Stripe
# Get from: https://dashboard.stripe.com/webhooks
STRIPE_WEBHOOK_SECRET=

# Publishable key — SAFE for client (prefixed with VITE_ for Vite exposure)
# Get from: https://dashboard.stripe.com/apikeys
VITE_STRIPE_PUBLISHABLE_KEY=

# Stripe Price IDs
# Pro monthly subscription price ID
STRIPE_PRO_PRICE_ID=

# Per-credit one-time purchase price ID (optional)
STRIPE_CREDIT_PRICE_ID=

# ── Optional: Observability ───────────────────────────────────────────────
# Sentry DSN for error tracking
# VITE_SENTRY_DSN=
SENTRY_DSN=